# Environment Configuration
PROJECT_NAME="OilSpill Backend API"
VERSION="0.1.0"
DESCRIPTION="FastAPI Backend for Oil Spill Detection and Management System"
API_V1_STR="/api/v1"
DEBUG=True
ENVIRONMENT="development"

# Server Settings
HOST="0.0.0.0"
PORT=8000

# CORS Settings (JSON list or comma-separated strings)
ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:5173","http://localhost:8000"]'

# OilTrace SAR+ML detection service (see docs/OilTrace_Detection_API.md)
ML_SERVICE_URL="https://vscimatic999--oiltrace-detection-web.modal.run"
ML_SERVICE_TIMEOUT=300.0

# ── Drift simulation (Ved's module) ──────────────────────────────────
# Paths to NetCDF forcing data.  Can be absolute or relative to cwd.
DRIFT_FORCING_CURRENTS_PATH="data/currents.nc"
DRIFT_FORCING_WIND_PATH="data/wind.nc"

# OpenOil simulation parameters
DRIFT_PARTICLE_COUNT=1000
DRIFT_OIL_TYPE="GENERIC BUNKER C"
DRIFT_DEFAULT_DURATION_HOURS=12
DRIFT_TIMESTEP_MINUTES=15
DRIFT_OUTPUT_INTERVAL_MINUTES=60

# KDE / source-region extraction
DRIFT_KDE_GRID_RESOLUTION=100
DRIFT_KDE_MARGIN_KM=0.5
# Highest-density region mass fraction.  0.95 = 95% HDR.
DRIFT_KDE_HDR_MASS_FRACTION=0.95
